{
  "name": "hiddengems",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Visual, map-first city discovery platform for authentic, budget-friendly hidden gems",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node scripts/seed.js",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
