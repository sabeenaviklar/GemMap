# Database
MONGODB_URI=mongodb://mongo:27017/hiddengems
# For non-Docker local dev:
# MONGODB_URI=mongodb://127.0.0.1:27017/hiddengems

# Security
# WARNING: Change this secret for any production deployment!
JWT_SECRET=hiddengems-super-secure-jwt-secret-key-32-chars-long!
ADMIN_EMAIL=admin@hiddengems.local

# File Upload Storage (Local folder outside public directory)
UPLOAD_DIR=./uploads

# Default Map Center & City Defaults (Mumbai Coordinates)
NEXT_PUBLIC_DEFAULT_CITY=Mumbai
NEXT_PUBLIC_DEFAULT_LAT=19.0760
NEXT_PUBLIC_DEFAULT_LNG=72.8777
PORT=3000
